  <vhdl appearance="logisim_evolution" name="D_Flip_Flop">--------------------------------------------------------------------------------&#13;
-- Project :&#13;
-- File    :&#13;
-- Autor   :&#13;
-- Date    :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY D_Flip_Flop IS&#13;
  PORT (&#13;

    clk : IN std_logic;
    d   : IN std_logic;
    q   : OUT std_logic

    );&#13;
END D_Flip_Flop;&#13;
&#13;
--------------------------------------------------------------------------------&#13;
--Complete your VHDL description below&#13;
--------------------------------------------------------------------------------&#13;
&#13;
ARCHITECTURE bhv OF D_Flip_Flop IS&#13;
&#13;
BEGIN&#13;
    &#13;process(clk)
    begin
        if rising_edge(clk) then
            q &lt;= d;
        end if;
    end process;
&#13;
END bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="D_Latch">--------------------------------------------------------------------------------&#13;
-- Project :&#13;
-- File    :&#13;
-- Autor   :&#13;
-- Date    :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY D_Latch IS&#13;
  PORT (&#13;
	d  : IN std_logic;&#13;
	en : IN std_logic;&#13;
	q  : OUT std_logic&#13;
	);&#13;
END D_Latch;&#13;
&#13;
--------------------------------------------------------------------------------&#13;
--Complete your VHDL description below&#13;
--------------------------------------------------------------------------------&#13;
&#13;
ARCHITECTURE bhv OF D_Latch IS&#13;
&#13;
BEGIN&#13;
	&#13;
process(d, en)&#13;
	begin&#13;
		if en = '1' then&#13;
			q &lt;= d;&#13;
		end if;&#13;
	end process;&#13;
&#13;
END bhv;&#13;
</vhdl>
