  <vhdl appearance="logisim_evolution" name="RS_Latch">--------------------------------------------------------------------------------&#13;
-- Project :&#13;
-- File    :&#13;
-- Autor   :&#13;
-- Date    :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY RS_Latch IS&#13;
  PORT (&#13;
  		s : IN std_logic;
		r : IN std_logic;
		q : OUT std_logic
	);&#13;
END RS_Latch;&#13;
&#13;
--------------------------------------------------------------------------------&#13;
--Complete your VHDL description below&#13;
--------------------------------------------------------------------------------&#13;
&#13;
ARCHITECTURE bhv OF RS_Latch IS&#13;
&#13;
BEGIN&#13;
&#13;process(s, r)
	begin
		if s = '1' and r = '0' then
			q &lt;= '1';
		elsif s = '0' and r = '1' then
			q &lt;= '0';
		elsif s = '1' and r = '1' then
			q &lt;= 'X';
		end if;
	end process;
&#13;
END bhv;&#13;
</vhdl>
