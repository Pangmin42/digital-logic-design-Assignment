  <vhdl appearance="logisim_evolution" name="JK_Flip_Flop">--------------------------------------------------------------------------------&#13;
-- Project :&#13;
-- File    :&#13;
-- Autor   :&#13;
-- Date    :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY JK_Flip_Flop IS&#13;
  PORT (&#13;
    	   clk : IN std_logic;
        j   : IN std_logic;
        k   : IN std_logic;
        q   : OUT std_logic

    );&#13;
END JK_Flip_Flop;&#13;
&#13;
--------------------------------------------------------------------------------&#13;
--Complete your VHDL description below&#13;
--------------------------------------------------------------------------------&#13;
&#13;
ARCHITECTURE bhv OF JK_Flip_Flop IS&#13;
&#13;	signal q_int : std_logic := '0';
BEGIN&#13;
&#13;    process(clk)
    begin
        if rising_edge(clk) then
            if j = '0' and k = '0' then
                q_int &lt;= q_int;

            elsif j = '0' and k = '1' then
                q_int &lt;= '0';

            elsif j = '1' and k = '0' then
                q_int &lt;= '1';

            elsif j = '1' and k = '1' then
                q_int &lt;= not q_int;
            end if;
        end if;
    end process;

    q &lt;= q_int;
&#13;
END bhv;&#13;
</vhdl>
