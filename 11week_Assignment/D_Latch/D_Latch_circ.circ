  <vhdl appearance="logisim_evolution" name="D_Latch">--------------------------------------------------------------------------------&#13;
-- Project :&#13;
-- File    :&#13;
-- Autor   :&#13;
-- Date    :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
-- Description :&#13;
--&#13;
--------------------------------------------------------------------------------&#13;
&#13;
LIBRARY ieee;&#13;
USE ieee.std_logic_1164.all;&#13;
&#13;
ENTITY D_Latch IS&#13;
  PORT (&#13;
	d  : IN std_logic;
	en : IN std_logic;
	q  : OUT std_logic
	);&#13;
END D_Latch;&#13;
&#13;
--------------------------------------------------------------------------------&#13;
--Complete your VHDL description below&#13;
--------------------------------------------------------------------------------&#13;
&#13;
ARCHITECTURE bhv OF D_Latch IS&#13;
&#13;
BEGIN&#13;
	&#13;process(d, en)
	begin
		if en = '1' then
			q &lt;= d;
		end if;
	end process;
&#13;
END bhv;&#13;
</vhdl>
